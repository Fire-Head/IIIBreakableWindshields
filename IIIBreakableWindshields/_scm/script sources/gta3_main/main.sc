                                    RESTORE_CAMERA_JUMPCUT
                                    SET_CAMERA_IN_FRONT_OF_PLAYER
                                ENDIF
                                WAIT 1000
                                IF IS_PLAYER_PLAYING player
                                    SET_PLAYER_CONTROL player 1
                                ENDIF
                            ENDIF
                        ENDIF
                    ENDIF
                ENDIF
            ENDIF
        ELSE
            IF $g230 = 1
                REMOVE_BLIP $g227
                $g230 = 0
            ENDIF
        ENDIF
    ENDIF
    GOTO S_SAVE_10
}
 
